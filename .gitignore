# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files

# Compiled output
/dist
/tmp
/out-tsc
/coverage

# Node
/node_modules
npm-debug.log
yarn-error.log
*.log

# Secrets — never commit (global rule 6)
.env
.env.local
.env.*.local

# Custody store and local runtime state — encrypted, still never committed.
# The directory is tracked so a fresh clone can run; its contents never are.
/data/*
!/data/.gitkeep

# IDEs and editors
.idea/
.project
.classpath
*.launch
.settings/
*.sublime-workspace
.history/*

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# System files
.DS_Store
Thumbs.db

# Agent instructions and local-only docs — kept on disk, never pushed
AGENTS.md
CLAUDE.md
README.local.md
docs/interop-notes.md
escrow_execution_plan.md

export NVM_DIR="$HOME/.nvm"
# shellcheck disable=SC1091
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"

# ── Capture staged files BEFORE any modifications ──────────────────
added_files=$(git diff --name-only --cached --diff-filter=d)
STAGED=$(git diff --cached --name-only --diff-filter=ACM)
STAGED_TS=$(echo "$STAGED" | grep '\.ts$' || true)

FAIL=0

echo ""
echo "⚡ cashu_escrow pre-commit checks..."
echo ""

# ── Rule 1: secrets never enter the repo ───────────
SECRET_FILES=$(echo "$STAGED" \
  | grep -E '(^|/)\.env($|\.)|(^|/)data/|\.enc$' \
  | grep -vE '(^|/)\.env\.example$|(^|/)data/\.gitkeep$' || true)
if [ -n "$SECRET_FILES" ]; then
  echo "❌ Secret or custody material staged — these must never be committed:"
  echo "$SECRET_FILES"
  echo "   Fix: git restore --staged <file>. Only .env.example belongs in git."
  echo ""
  FAIL=1
fi

# ── Rule 2: no custody material on stdout ───────────
# nsec, token strings, proofs, preimages and payout instructions are never logged.
if [ -n "$STAGED_TS" ]; then
  LEAKY=$(echo "$STAGED_TS" | tr '\n' ' ' | xargs grep -nE \
    'console\.[a-z]+\([^)]*\b(nsec|privkey|privateKey|secretKey|proofs?|preimage|tokenStr|lockedToken|payout(Target|Instruction))\b' \
    2>/dev/null | grep -v '\.test\.ts' || true)
  if [ -n "$LEAKY" ]; then
    echo "❌ Custody material reaching a log call:"
    echo "$LEAKY"
    echo "   Fix: log the swap_id and a typed error category — never the material."
    echo ""
    FAIL=1
  fi
fi

# ── Rule 3: the kernel stays profile-agnostic ───────
STAGED_CUSTODY=$(echo "$STAGED_TS" | grep '^src/lib/' || true)
if [ -n "$STAGED_CUSTODY" ]; then
  # The custody layer never depends on the policy layer.
  BOUNDARY=$(echo "$STAGED_CUSTODY" | tr '\n' ' ' | xargs grep -nE \
    "from '[^']*\\boperator/" 2>/dev/null || true)
  if [ -n "$BOUNDARY" ]; then
    echo "❌ src/lib imports from src/operator (invariant I8):"
    echo "$BOUNDARY"
    echo "   Fix: the custody layer must not depend on the policy layer."
    echo ""
    FAIL=1
  fi
fi

STAGED_KERNEL=$(echo "$STAGED_TS" | grep '^src/lib/pontmore/' || true)
if [ -n "$STAGED_KERNEL" ]; then
  # The kernel speaks core/* only: no profile import, no profile vocabulary.
  PROFILE=$(echo "$STAGED_KERNEL" | tr '\n' ' ' | xargs grep -nE \
    "from '[^']*\\bprofiles/|['\"]swap/" 2>/dev/null || true)
  if [ -n "$PROFILE" ]; then
    echo "❌ Profile semantics leaking into the kernel (invariant I8):"
    echo "$PROFILE"
    echo "   Fix: terms, roles and profile actions belong in src/lib/profiles."
    echo ""
    FAIL=1
  fi
fi

# ── Linting + formatting + types + unit tests ──────────────────────
run_check() {
  label=$1
  shift
  if ! "$@"; then
    echo ""
    echo "❌ $label failed."
    echo "   Command: $*"
    echo ""
    FAIL=1
  fi
}

run_check "lint-staged (eslint + prettier on staged files)" \
  npx --no lint-staged

run_check "eslint" \
  npx --no eslint . --fix

run_check "typecheck" \
  npm run --silent typecheck

run_check "unit tests" \
  npm run --silent test

# Re-stage whatever the --fix passes rewrote. NUL-delimited so paths
# containing spaces survive.
if [ -n "$added_files" ]; then
  printf '%s\n' "$added_files" | tr '\n' '\0' | xargs -0 git add --
fi

# ── Final gate ─────────────────────────────────────────────────────
echo ""
if [ "$FAIL" -eq 1 ]; then
  echo "🚫 Commit blocked. Fix the issues above, then commit again."
  exit 1
else
  echo "✅ All checks passed."
  exit 0
fi
